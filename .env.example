# ── AI Interview Copilot — Configuration ───────────────────────────────────

# ── REQUIRED: Groq API key (free) ─────────────────────────────────────────
# Get yours at https://console.groq.com/keys (sign in with Google, no credit card needed)
# Powers both transcription (Whisper) AND the AI responses (Llama 3.3)
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ── DEFAULTS: cloud mode (recommended) ────────────────────────────────────
# Tells the app to use Groq for the LLM responses
KB_LLM_BACKEND=groq

# Cloud LLM endpoint — Groq is OpenAI-compatible
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1

# Quick model (used during live conversation — must be fast)
OPENAI_COMPAT_QUICK_MODEL=llama-3.3-70b-versatile

# Research model (used when you ask for deeper answers)
OPENAI_COMPAT_RESEARCH_MODEL=llama-3.3-70b-versatile

# Whisper model for transcription
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── OPTIONAL: Channelry AI (3rd-party client, same pattern as SpaceWorker) ──
# Connects the interviewer AI to Channelry app AI via the external AI chat relay.
# POST {CHANNELRY_AI_BASE_URL}/external/ai-chat  Authorization: Bearer {CHANNELRY_AI_API_KEY}
# The client "ai-interview-copilot" must be registered on the Channelry side
# (admin API POST /admin/external-clients) before calls succeed.
CHANNELRY_AI_BASE_URL=https://channelry-admin.olowolabiakinwale.workers.dev
CHANNELRY_AI_API_KEY=ck_YOUR_CHANNELRY_EXTERNAL_CLIENT_KEY_HERE
CHANNELRY_AI_EXTERNAL_USER_ID=interview-copilot-user

# ── OPTIONAL: knowledge base location ─────────────────────────────────────
# Folder containing your .md / .txt / .pdf / .docx files
KB_ROOT=./kb

# Server port
PORT=5055

# ── ADVANCED: offline mode (Ollama + local Whisper) ───────────────────────
# Uncomment these IF you want to run fully offline (requires Ollama + faster-whisper installed)
# KB_LLM_BACKEND=ollama
# OLLAMA_MODEL=llama3.1:8b
# WHISPER_MODEL=tiny.en
